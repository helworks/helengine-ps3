// Unlit vertex program: transforms the model-space position by the combined
// model/view/projection matrix and passes the per-vertex face color through.
void main(float3 position : POSITION, float4 color : COLOR0,
          uniform float4x4 mvp,
          out float4 clip : POSITION, out float4 tint : COLOR0) {
    clip = mul(mvp, float4(position, 1.0));
    tint = color;
}
