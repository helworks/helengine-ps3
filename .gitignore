# Repo-local PS3 toolchain caches, generated trees, builds and logs.
/.ps3/*
!/.ps3/.gitkeep

# These patterns also guard against generated products landing outside .ps3.
/build/
/out/
*.elf
*.self
*.map
*.o
*.d
*.vpo
*.fpo
*.log
build-manifest.json
tests/native/*.exe
tests/native/*.out

# Managed builder assembly outputs. The builder's sources are tracked; everything MSBuild
# produces from them is not.
bin/
obj/
